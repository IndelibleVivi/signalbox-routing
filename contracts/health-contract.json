{
  "schema": "signalbox.health-contract/v4",
  "contract_revision": 4,
  "transient_outcomes": [
    "checking"
  ],
  "terminal_outcomes": [
    "pass",
    "fail",
    "unknown"
  ],
  "rollup_precedence": [
    "fail",
    "unknown",
    "pass"
  ],
  "profile_kinds": {
    "recovery-preflight": {
      "required_dimensions": [
        "control-plane",
        "enforcement",
        "resources",
        "persistence",
        "recovery-readiness"
      ],
      "observation_scope": "single-control-plane",
      "compatible_subject_kinds": [
        "control-plane"
      ],
      "cardinality_per_subject": "exactly-one",
      "may_gate_restore": true,
      "may_feed_deployment_aggregate": false
    },
    "control-plane-operational": {
      "required_dimensions": [
        "control-plane",
        "enforcement",
        "resources",
        "persistence",
        "recovery-readiness"
      ],
      "observation_scope": "single-control-plane",
      "compatible_subject_kinds": [
        "control-plane"
      ],
      "cardinality_per_subject": "exactly-one",
      "may_gate_restore": false,
      "may_feed_deployment_aggregate": true
    },
    "lane-operational": {
      "required_dimensions": [
        "transport",
        "exit-identity",
        "dns"
      ],
      "observation_scope": "single-lane",
      "compatible_subject_kinds": [
        "egress-lane",
        "private-ingress-lane"
      ],
      "cardinality_per_subject": "exactly-one",
      "may_gate_restore": false,
      "may_feed_deployment_aggregate": true
    }
  },
  "required_profile_fields": [
    "id",
    "revision",
    "kind",
    "subject_ref",
    "observation_only",
    "required_dimensions",
    "probe_requirements",
    "aggregation",
    "freshness",
    "publication",
    "retention",
    "privacy"
  ],
  "required_report_fields": [
    "schema",
    "id",
    "profile_ref",
    "profile_revision",
    "producer_ref",
    "subject_ref",
    "generation_epoch",
    "generation",
    "attempt_id",
    "started_at",
    "completed_at",
    "published_at",
    "valid_until",
    "outcome",
    "dimensions"
  ],
  "required_dimension_fields": [
    "state",
    "observations"
  ],
  "required_observation_fields": [
    "probe_ref",
    "evidence_class",
    "dependency_group",
    "state",
    "observed_at"
  ],
  "evidence_evaluation": {
    "canonical_report_schema": "signalbox.health-report/v2",
    "structural_and_semantic_validity_required": true,
    "effective_window": "published_at <= evaluated_at <= valid_until",
    "invalid_effective_outcome": "unknown",
    "current_identity_match": "exact"
  },
  "generation": {
    "scope_fields": [
      "producer_ref",
      "subject_ref",
      "profile_ref",
      "generation_epoch"
    ],
    "monotonic_within_scope": true,
    "epoch_durable_across_process_and_boot_restart": true,
    "epoch_change_requires": "explicit-reset-or-migration",
    "unexpected_epoch_effective_outcome": "unknown",
    "regression_effective_outcome": "unknown"
  },
  "freshness": {
    "required": true,
    "basis": "valid_until",
    "maximum_formula": "valid_until <= completed_at + profile.max_report_age_seconds",
    "published_before_or_at_valid_until": true,
    "stale_effective_outcome": "unknown",
    "missing_or_malformed_effective_outcome": "unknown",
    "profile_revision_mismatch_effective_outcome": "unknown"
  },
  "recovery_gate": {
    "profile_kind": "recovery-preflight",
    "required_context_fields": [
      "operation_ref",
      "desired_state_digest",
      "observed_runtime_generation",
      "restore_scope_ref"
    ],
    "exact_context_match_required": true,
    "required_current_identity_fields": [
      "producer_ref",
      "subject_ref",
      "profile_ref",
      "profile_revision",
      "generation_epoch",
      "generation",
      "report_id",
      "attempt_id"
    ],
    "exact_current_identity_match_required": true,
    "higher_than_expected_generation_action": "abort-and-reread-current-pointer",
    "required_effective_outcome": "pass"
  },
  "deployment_aggregate": {
    "member_reports_immutable": true,
    "preserve_per_subject_outcome": true,
    "top_level_outcome_forbidden": true,
    "recovery_preflight_members_forbidden": true,
    "evaluated_at_must_equal_assembled_at": true,
    "member_outcome_field": "effective_outcome_at_assembly",
    "historical_receipt": true,
    "member_evaluation_requires_canonical_validity": true
  },
  "publication": {
    "terminal_report_required_for_every_attempt": true,
    "early_failure_must_publish": true,
    "current_write": "atomic-replace",
    "failed_and_unknown_attempts_advance_generation": true,
    "report_immutable": true
  },
  "query_failure_outcome": "unknown",
  "observation_only": true,
  "retention_policy_required_fields": [
    "max_file_bytes",
    "archive_count",
    "max_entries"
  ],
  "forbidden_durable_keys": [
    "credential",
    "password",
    "token",
    "private_key",
    "exit_ip",
    "client_ip",
    "client_mac",
    "raw_url",
    "raw_response"
  ],
  "reason_codes": [
    "timeout",
    "unreachable",
    "identity-mismatch",
    "query-unsupported",
    "query-failed",
    "stale",
    "resource-pressure",
    "storage-pressure",
    "oom-observed",
    "persistence-unverified",
    "recovery-unready",
    "missing-required-result",
    "malformed-evidence",
    "generation-regressed",
    "generation-epoch-mismatch",
    "profile-revision-mismatch",
    "gate-context-mismatch",
    "current-evidence-mismatch",
    "evidence-not-yet-published"
  ]
}
