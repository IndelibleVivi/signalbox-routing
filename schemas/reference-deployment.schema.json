{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signalbox:schema:reference-deployment:v2",
  "title": "Signalbox reference deployment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_revision",
    "deployment_id",
    "display_name",
    "sample_only",
    "private_live_bindings",
    "router",
    "instances",
    "dedicated_gateway_identities",
    "canonical_origins",
    "health_subjects",
    "traffic_policy_ref",
    "health_profiles_ref",
    "health_aggregate_ref"
  ],
  "properties": {
    "schema": {"const": "signalbox.reference-deployment/v2"},
    "contract_revision": {"type": "integer", "minimum": 2},
    "deployment_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "sample_only": {"const": true},
    "private_live_bindings": {"const": "external-and-absent"},
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "display_name", "role"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "instances": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display_name", "roles"],
        "properties": {
          "display_name": {"type": "string", "minLength": 1},
          "roles": {"$ref": "#/$defs/stringSet"}
        }
      }
    },
    "dedicated_gateway_identities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host_instance", "role", "credential_scope", "general_egress_equivalent"],
        "properties": {
          "host_instance": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "credential_scope": {"const": "dedicated"},
          "general_egress_equivalent": {"const": false}
        }
      }
    },
    "canonical_origins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "hostname_ref", "public_path_required", "private_path_optional"],
        "properties": {
          "scheme": {"enum": ["http", "https"]},
          "hostname_ref": {"const": "deployment-owned-and-absent"},
          "public_path_required": {"type": "boolean"},
          "private_path_optional": {"type": "boolean"}
        }
      }
    },
    "health_subjects": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "binding_ref"],
        "properties": {
          "kind": {"enum": ["control-plane", "egress-lane", "private-ingress-lane"]},
          "binding_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "traffic_policy_ref": {"type": "string", "minLength": 1},
    "health_profiles_ref": {"type": "string", "minLength": 1},
    "health_aggregate_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
