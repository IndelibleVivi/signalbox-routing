{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signalbox:schema:docs-pairs:v3",
  "title": "Signalbox bilingual documentation pairs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_revision", "pairs"],
  "properties": {
    "schema": {"const": "signalbox.docs-pairs/v3"},
    "contract_revision": {"type": "integer", "minimum": 4},
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doc_id",
          "zh-CN",
          "en",
          "required_contract_ids",
          "required_sections"
        ],
        "properties": {
          "doc_id": {"type": "string", "minLength": 1},
          "zh-CN": {"$ref": "#/$defs/repoPath"},
          "en": {"$ref": "#/$defs/repoPath"},
          "required_contract_ids": {"$ref": "#/$defs/stringSet"},
          "required_sections": {"$ref": "#/$defs/stringSet"}
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
