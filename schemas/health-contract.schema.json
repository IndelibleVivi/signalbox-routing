{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signalbox:schema:health-contract:v3",
  "title": "Signalbox health contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_revision",
    "transient_outcomes",
    "terminal_outcomes",
    "rollup_precedence",
    "profile_kinds",
    "required_profile_fields",
    "required_report_fields",
    "required_dimension_fields",
    "required_observation_fields",
    "generation",
    "freshness",
    "recovery_gate",
    "deployment_aggregate",
    "publication",
    "query_failure_outcome",
    "observation_only",
    "retention_policy_required_fields",
    "forbidden_durable_keys",
    "reason_codes"
  ],
  "properties": {
    "schema": {"const": "signalbox.health-contract/v3"},
    "contract_revision": {"type": "integer", "minimum": 3},
    "transient_outcomes": {"$ref": "#/$defs/stringSet"},
    "terminal_outcomes": {"$ref": "#/$defs/stringSet"},
    "rollup_precedence": {"$ref": "#/$defs/stringSet"},
    "profile_kinds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovery-preflight", "control-plane-operational", "lane-operational"],
      "properties": {
        "recovery-preflight": {"$ref": "#/$defs/profileKind"},
        "control-plane-operational": {"$ref": "#/$defs/profileKind"},
        "lane-operational": {"$ref": "#/$defs/profileKind"}
      }
    },
    "required_profile_fields": {"$ref": "#/$defs/stringSet"},
    "required_report_fields": {"$ref": "#/$defs/stringSet"},
    "required_dimension_fields": {"$ref": "#/$defs/stringSet"},
    "required_observation_fields": {"$ref": "#/$defs/stringSet"},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_fields",
        "monotonic_within_scope",
        "epoch_durable_across_process_and_boot_restart",
        "epoch_change_requires",
        "unexpected_epoch_effective_outcome",
        "regression_effective_outcome"
      ],
      "properties": {
        "scope_fields": {"$ref": "#/$defs/stringSet"},
        "monotonic_within_scope": {"type": "boolean"},
        "epoch_durable_across_process_and_boot_restart": {"type": "boolean"},
        "epoch_change_requires": {"type": "string", "minLength": 1},
        "unexpected_epoch_effective_outcome": {"$ref": "#/$defs/terminal"},
        "regression_effective_outcome": {"$ref": "#/$defs/terminal"}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "basis",
        "maximum_formula",
        "published_before_or_at_valid_until",
        "stale_effective_outcome",
        "missing_or_malformed_effective_outcome",
        "profile_revision_mismatch_effective_outcome"
      ],
      "properties": {
        "required": {"type": "boolean"},
        "basis": {"type": "string", "minLength": 1},
        "maximum_formula": {"type": "string", "minLength": 1},
        "published_before_or_at_valid_until": {"type": "boolean"},
        "stale_effective_outcome": {"$ref": "#/$defs/terminal"},
        "missing_or_malformed_effective_outcome": {"$ref": "#/$defs/terminal"},
        "profile_revision_mismatch_effective_outcome": {"$ref": "#/$defs/terminal"}
      }
    },
    "recovery_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_kind",
        "required_context_fields",
        "exact_context_match_required",
        "required_effective_outcome"
      ],
      "properties": {
        "profile_kind": {"type": "string", "minLength": 1},
        "required_context_fields": {"$ref": "#/$defs/stringSet"},
        "exact_context_match_required": {"type": "boolean"},
        "required_effective_outcome": {"$ref": "#/$defs/terminal"}
      }
    },
    "deployment_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member_reports_immutable",
        "preserve_per_subject_outcome",
        "top_level_outcome_forbidden",
        "recovery_preflight_members_forbidden",
        "evaluated_at_must_equal_assembled_at",
        "member_outcome_field",
        "historical_receipt"
      ],
      "properties": {
        "member_reports_immutable": {"type": "boolean"},
        "preserve_per_subject_outcome": {"type": "boolean"},
        "top_level_outcome_forbidden": {"type": "boolean"},
        "recovery_preflight_members_forbidden": {"type": "boolean"},
        "evaluated_at_must_equal_assembled_at": {"type": "boolean"},
        "member_outcome_field": {"const": "effective_outcome_at_assembly"},
        "historical_receipt": {"type": "boolean"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_report_required_for_every_attempt",
        "early_failure_must_publish",
        "current_write",
        "failed_and_unknown_attempts_advance_generation",
        "report_immutable"
      ],
      "properties": {
        "terminal_report_required_for_every_attempt": {"type": "boolean"},
        "early_failure_must_publish": {"type": "boolean"},
        "current_write": {"type": "string", "minLength": 1},
        "failed_and_unknown_attempts_advance_generation": {"type": "boolean"},
        "report_immutable": {"type": "boolean"}
      }
    },
    "query_failure_outcome": {"$ref": "#/$defs/terminal"},
    "observation_only": {"type": "boolean"},
    "retention_policy_required_fields": {"$ref": "#/$defs/stringSet"},
    "forbidden_durable_keys": {"$ref": "#/$defs/stringSet"},
    "reason_codes": {"$ref": "#/$defs/stringSet"}
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "terminal": {"enum": ["pass", "fail", "unknown"]},
    "profileKind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_dimensions",
        "observation_scope",
        "may_gate_restore",
        "may_feed_deployment_aggregate"
      ],
      "properties": {
        "required_dimensions": {"$ref": "#/$defs/stringSet"},
        "observation_scope": {"type": "string", "minLength": 1},
        "may_gate_restore": {"type": "boolean"},
        "may_feed_deployment_aggregate": {"type": "boolean"}
      }
    }
  }
}
