{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signalbox:schema:claims:v1",
  "title": "Signalbox realization and acceptance claims",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_revision",
    "observation_outcomes",
    "realization_stages",
    "required_realization_references",
    "acceptance_record"
  ],
  "properties": {
    "schema": {"const": "signalbox.claims/v1"},
    "contract_revision": {"type": "integer", "minimum": 1},
    "observation_outcomes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["pass", "fail", "unknown"]}
    },
    "realization_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rank", "authority", "proves", "does_not_prove"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 1},
          "authority": {"type": "string", "minLength": 1},
          "proves": {"type": "string", "minLength": 1},
          "does_not_prove": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_realization_references": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "acceptance_record": {"type": "object"}
  }
}
