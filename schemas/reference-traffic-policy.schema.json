{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signalbox:schema:reference-traffic-policy:v3",
  "title": "Signalbox Mintie reference traffic policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_revision",
    "deployment_ref",
    "protected_scope",
    "health_profile_refs",
    "route_order",
    "failure_behavior"
  ],
  "properties": {
    "schema": {"const": "signalbox.reference-traffic-policy/v3"},
    "contract_revision": {"type": "integer", "minimum": 3},
    "deployment_ref": {"type": "string", "minLength": 1},
    "protected_scope": {"type": "string", "minLength": 1},
    "health_profile_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovery_preflight", "control_plane", "lanes"],
      "properties": {
        "recovery_preflight": {"type": "string", "minLength": 1},
        "control_plane": {"type": "string", "minLength": 1},
        "lanes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "route_order": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/route"}
    },
    "failure_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "on_fail", "on_unknown"],
      "properties": {
        "mode": {"const": "fail-closed"},
        "on_fail": {"const": "retain-guard"},
        "on_unknown": {"const": "retain-guard"}
      }
    }
  },
  "$defs": {
    "explicitMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "set_ref"],
      "properties": {
        "kind": {"const": "explicit-allowlist"},
        "set_ref": {"type": "string", "minLength": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "role_binding_ref"],
      "properties": {
        "mode": {"const": "pinned"},
        "role_binding_ref": {"type": "string", "minLength": 1}
      }
    },
    "route": {
      "oneOf": [
        {"$ref": "#/$defs/protocolObservation"},
        {"$ref": "#/$defs/dnsCapture"},
        {"$ref": "#/$defs/canonicalPrivateIngress"},
        {"$ref": "#/$defs/protectedUdpPolicy"},
        {"$ref": "#/$defs/protectedApplication"},
        {"$ref": "#/$defs/privateDirect"},
        {"$ref": "#/$defs/approvedDirect"},
        {"$ref": "#/$defs/defaultProxyRequired"}
      ]
    },
    "protocolObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "properties": {
        "id": {"const": "protocol-observation"},
        "action": {"const": "observe-protocol"}
      }
    },
    "dnsCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "properties": {
        "id": {"const": "dns-capture"},
        "action": {"const": "capture-client-dns"}
      }
    },
    "canonicalPrivateIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "match",
        "action",
        "gateway_binding_ref",
        "canonical_origin_ref"
      ],
      "properties": {
        "id": {"const": "canonical-private-ingress"},
        "match": {"const": "approved-canonical-origin-set"},
        "action": {"const": "private-ingress"},
        "gateway_binding_ref": {"type": "string", "minLength": 1},
        "canonical_origin_ref": {"type": "string", "minLength": 1}
      }
    },
    "protectedUdpPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "action"],
      "properties": {
        "id": {"const": "protected-udp-policy"},
        "match": {"const": "protected-application-udp-443"},
        "action": {"const": "reject-until-verified"}
      }
    },
    "protectedApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "action", "role_binding_ref"],
      "properties": {
        "id": {"const": "protected-application"},
        "match": {"const": "high-recall-protected-set"},
        "action": {"const": "route"},
        "role_binding_ref": {"type": "string", "minLength": 1}
      }
    },
    "privateDirect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "action"],
      "properties": {
        "id": {"const": "private-direct"},
        "match": {
          "allOf": [
            {"$ref": "#/$defs/explicitMatch"},
            {"properties": {"set_ref": {"const": "approved-private-destinations"}}}
          ]
        },
        "action": {"const": "direct"}
      }
    },
    "approvedDirect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "action"],
      "properties": {
        "id": {"const": "approved-direct"},
        "match": {
          "allOf": [
            {"$ref": "#/$defs/explicitMatch"},
            {"properties": {"set_ref": {"const": "deployment-approved-direct-set"}}}
          ]
        },
        "action": {"const": "direct"}
      }
    },
    "defaultProxyRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "action", "selection"],
      "properties": {
        "id": {"const": "default-proxy-required"},
        "match": {"const": "otherwise"},
        "action": {"const": "route"},
        "selection": {"$ref": "#/$defs/selection"}
      }
    }
  }
}
