{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signalbox:schema:contract-catalog:v1",
  "title": "Signalbox contract catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_revision", "entries"],
  "properties": {
    "schema": {"const": "signalbox.contract-catalog/v1"},
    "catalog_revision": {"type": "integer", "minimum": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_schema_id", "breaking_change"],
      "properties": {
        "same_schema_id": {"const": "backward-compatible-only"},
        "breaking_change": {"const": "new-schema-id-required"}
      }
    },
    "instance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {"path": {"$ref": "#/$defs/repoPath"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "pointer"],
          "properties": {
            "path": {"$ref": "#/$defs/repoPath"},
            "pointer": {"type": "string", "pattern": "^/"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["glob"],
          "properties": {"glob": {"$ref": "#/$defs/repoPath"}}
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "revision",
        "owner",
        "schema_path",
        "compatibility",
        "projection_dependencies",
        "instances"
      ],
      "properties": {
        "schema_id": {"type": "string", "pattern": "^signalbox\\.[a-z0-9.-]+/v[1-9][0-9]*$"},
        "revision": {"type": "integer", "minimum": 1},
        "owner": {"$ref": "#/$defs/repoPath"},
        "schema_path": {"$ref": "#/$defs/repoPath"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "projection_dependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/repoPath"},
          "uniqueItems": true
        },
        "instances": {
          "type": "array",
          "items": {"$ref": "#/$defs/instance"}
        }
      }
    }
  }
}
