{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signalbox:schema:acceptance-record:v2",
  "title": "Signalbox acceptance-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "actor_class",
    "actor_ref",
    "decision",
    "scope_ref",
    "claim_refs",
    "evidence_refs",
    "decided_at"
  ],
  "properties": {
    "schema": {
      "const": "signalbox.acceptance-record/v2"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_class": {
      "enum": [
        "human",
        "client",
        "agent"
      ]
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected",
        "revoked"
      ]
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "claim_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
