{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signalbox:schema:roles:v1",
  "title": "Signalbox portable roles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_revision", "roles"],
  "properties": {
    "schema": {"const": "signalbox.roles/v1"},
    "contract_revision": {"type": "integer", "minimum": 1},
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "responsibility", "required_capabilities"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1},
          "server_control_required": {"type": "boolean"},
          "automatic_failover_implied": {"type": "boolean"},
          "optimization_target": {"type": "string", "minLength": 1},
          "required_capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "forbidden_degradations": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
