{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signalbox:schema:handoff:v1",
  "title": "Signalbox handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_id",
    "scope_ref",
    "synthetic",
    "evidence",
    "claims",
    "acceptance_records"
  ],
  "properties": {
    "schema": {
      "const": "signalbox.handoff/v1"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "const": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope_ref",
          "stage",
          "artifact_ref",
          "observed_at",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope_ref": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "source",
              "installed",
              "activated",
              "path-evidence"
            ]
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "claim_id",
          "scope_ref",
          "stage",
          "outcome",
          "evidence_refs",
          "observed_at"
        ],
        "properties": {
          "schema": {
            "const": "signalbox.claim-record/v1"
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "scope_ref": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "source",
              "installed",
              "activated",
              "path-evidence"
            ]
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "installed_ref": {
            "type": "string",
            "minLength": 1
          },
          "runtime_generation": {
            "type": "string",
            "minLength": 1
          },
          "activated_ref": {
            "type": "string",
            "minLength": 1
          },
          "health_report_ref": {
            "type": "string",
            "minLength": 1
          },
          "current_health_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "producer_ref",
              "subject_ref",
              "profile_ref",
              "profile_revision",
              "generation_epoch",
              "generation",
              "report_id",
              "attempt_id"
            ],
            "properties": {
              "producer_ref": {
                "type": "string",
                "minLength": 1
              },
              "subject_ref": {
                "type": "string",
                "minLength": 1
              },
              "profile_ref": {
                "type": "string",
                "minLength": 1
              },
              "generation_epoch": {
                "type": "string",
                "minLength": 1
              },
              "report_id": {
                "type": "string",
                "minLength": 1
              },
              "attempt_id": {
                "type": "string",
                "minLength": 1
              },
              "profile_revision": {
                "type": "integer",
                "minimum": 1
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "acceptance_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "record_id",
          "actor_class",
          "actor_ref",
          "decision",
          "scope_ref",
          "claim_refs",
          "evidence_refs",
          "decided_at"
        ],
        "properties": {
          "schema": {
            "const": "signalbox.acceptance-record/v2"
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "actor_class": {
            "enum": [
              "human",
              "client",
              "agent"
            ]
          },
          "actor_ref": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "accepted",
              "rejected",
              "revoked"
            ]
          },
          "scope_ref": {
            "type": "string",
            "minLength": 1
          },
          "claim_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
